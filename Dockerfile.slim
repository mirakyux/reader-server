FROM eclipse-temurin:21-jdk-alpine AS build-api
WORKDIR /app
COPY gradlew settings.gradle* build.gradle.kts ./
COPY gradle gradle
COPY src src
RUN chmod +x gradlew && ./gradlew --no-daemon test bootJar
# Reflection, legacy charsets, image covers and TLS need explicit modules.
RUN jlink --add-modules java.base,java.logging,java.naming,java.sql,java.xml,java.management,java.instrument,java.desktop,java.security.jgss,java.net.http,jdk.unsupported,jdk.crypto.ec,jdk.charsets,jdk.zipfs,jdk.naming.dns --strip-debug --no-header-files --no-man-pages --compress=2 --output /opt/jre

FROM alpine:3.24.2
RUN apk add --no-cache ca-certificates tini tzdata libstdc++ zlib freetype fontconfig
ENV TZ=Asia/Shanghai JAVA_HOME=/opt/jre PATH="/opt/jre/bin:${PATH}"
WORKDIR /app
COPY --from=build-api /opt/jre /opt/jre
COPY --from=build-api /app/build/backend/libs/reader.jar /app/bin/reader.jar
EXPOSE 8080
ENTRYPOINT ["/sbin/tini", "--"]
CMD ["java", "-jar", "/app/bin/reader.jar"]
