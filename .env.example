# Copy to .env and set a random token shared only by API and browser services.
READER_BROWSER_TOKEN=
READER_WEB_PORT=4396
# Set the exact browser origin, including port, when using a LAN address or domain.
READER_CORS_ALLOWED_ORIGINS=http://localhost:4396,http://127.0.0.1:4396
READER_APP_SECURE=false
READER_APP_SECUREKEY=
READER_APP_INVITECODE=
