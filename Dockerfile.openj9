FROM eclipse-temurin:21-jdk-alpine AS build-api
WORKDIR /app
COPY gradlew settings.gradle* build.gradle.kts ./
COPY gradle gradle
COPY src src
RUN chmod +x gradlew && ./gradlew --no-daemon test bootJar

FROM ibm-semeru-runtimes:open-21-jre
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates tini tzdata && rm -rf /var/lib/apt/lists/*
ENV TZ=Asia/Shanghai
WORKDIR /app
COPY --from=build-api /app/build/backend/libs/reader.jar /app/bin/reader.jar
EXPOSE 8080
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["java", "-jar", "/app/bin/reader.jar"]
